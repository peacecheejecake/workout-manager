{
  "schemaVersion": 1,
  "purpose": "Blinded sample for the independent Korean pedestrian routing coverage review (M0-06b, matrix P8-coverage). Contains no engine result and no expected result.",
  "coordinates": "[longitude, latitude], WGS84. Synthetic, rounded points at public landmarks chosen by hand; approximate on purpose. No personal GPS data.",
  "system": {
    "engine": "Self-hosted GraphHopper 10.0, pedestrian profile foot-v1 (flexible, no contraction hierarchies)",
    "data": "OpenStreetMap, Geofabrik South Korea extract south-korea-260901 (road data 2026-09-01)",
    "outcomes": [
      "route_computed",
      "no_route",
      "outside_coverage",
      "snap_too_far",
      "timeout",
      "compute_budget_exceeded",
      "rejected_before_engine"
    ],
    "outcomeMeaning": {
      "route_computed": "a walking route was returned",
      "no_route": "both ends are on the network but there is no walking connection",
      "outside_coverage": "at least one point has no pedestrian network near it at all",
      "snap_too_far": "a point would have to move more than 120 m onto the network",
      "timeout": "the 8 s deadline elapsed",
      "compute_budget_exceeded": "the engine search budget (1,000,000 visited nodes) was exhausted",
      "rejected_before_engine": "the request broke a contract limit and the engine was not called"
    },
    "limits": {
      "maxSnapMeters": 120,
      "maxLegStraightLineMeters": 30000,
      "maxRouteDistanceMeters": 250000,
      "deadlineMilliseconds": 8000,
      "maxEngineVisitedNodes": 1000000
    }
  },
