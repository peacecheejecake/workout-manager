{
  "name": "@workout/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./primitives": {
      "types": "./src/primitives.ts",
      "default": "./dist/primitives.js"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./dist/core.js"
    },
    "./nutrition": {
      "types": "./src/nutrition.ts",
      "default": "./dist/nutrition.js"
    },
    "./routines": {
      "types": "./src/routines.ts",
      "default": "./dist/routines.js"
    },
    "./approval": {
      "types": "./src/approval.ts",
      "default": "./dist/approval.js"
    },
    "./planning": {
      "types": "./src/planning.ts",
      "default": "./dist/planning.js"
    },
    "./operations": {
      "types": "./src/operations.ts",
      "default": "./dist/operations.js"
    },
    "./activity": {
      "types": "./src/activity.ts",
      "default": "./dist/activity.js"
    },
    "./garmin": {
      "types": "./src/garmin.ts",
      "default": "./dist/garmin.js"
    },
    "./check-ins": {
      "types": "./src/check-ins.ts",
      "default": "./dist/check-ins.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
