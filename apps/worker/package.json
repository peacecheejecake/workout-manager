{
  "name": "@workout/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "build": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "coaching:fixture": "tsx src/start.ts",
    "resources:cleanup": "node --import tsx src/resource-cleanup.ts",
    "resources:url-ingest": "node --import tsx src/url-ingestion.ts",
    "courses:thumbnails": "node --import tsx src/course-thumbnail.ts"
  },
  "dependencies": {
    "@workout/contracts": "workspace:*",
    "@workout/server-coaching": "workspace:*",
    "@workout/server-courses": "workspace:*",
    "@workout/server-media": "workspace:*",
    "@workout/server-persistence": "workspace:*",
    "@workout/server-resource-ingestion": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
