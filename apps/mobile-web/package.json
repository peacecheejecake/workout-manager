{
  "name": "@workout/mobile-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "build": "node ../../scripts/copy-map-worker.mjs && node ../../scripts/generate-ui-notices.mjs && vite build",
    "dev": "node ../../scripts/copy-map-worker.mjs && node ../../scripts/generate-ui-notices.mjs && vite --host 127.0.0.1 --port 4200 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4200 --strictPort"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@workout/platform": "workspace:*",
    "@workout/modules-activities": "workspace:*",
    "@workout/contracts": "workspace:*",
    "@workout/ui-foundation": "workspace:*",
    "@workout/ui-spike": "workspace:*"
  }
}
