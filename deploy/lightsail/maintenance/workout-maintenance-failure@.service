[Unit]
Description=Record Workout Manager maintenance failure (%i)

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'umask 077; mkdir -p /var/lib/workout-manager/maintenance; date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ > /var/lib/workout-manager/maintenance/%i.failed-at'
StandardOutput=journal
StandardError=journal
