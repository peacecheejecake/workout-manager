# Inactive cutover candidate. Replace only the Workout 503 site block after the
# deployment gates in README.md; retain the existing apex site block verbatim.
# Caddy must share infra_default with the Workout app for this alias to resolve.
workout.red-10-proto.xyz {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	reverse_proxy wm-hosting-app:3100
}
