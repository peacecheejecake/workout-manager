{
  "name": "workout-manager-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck && tsc --project tsconfig.json",
    "test": "pnpm --filter @workout/contracts build && vitest run",
    "test:watch": "pnpm --filter @workout/contracts build && vitest",
    "test:coverage": "pnpm --filter @workout/contracts build && vitest run --coverage",
    "test:integration": "node scripts/test-postgres.mjs",
    "test:e2e": "playwright test",
    "build": "turbo run build",
    "dev:fixture": "vite --config packages/tooling/fixtures/ui/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:shells": "playwright test --config playwright.shells.config.ts",
    "dev:web": "pnpm --filter @workout/contracts build && pnpm --filter @workout/web dev",
    "dev:mobile-web": "pnpm --filter @workout/contracts build && pnpm --filter @workout/mobile-web dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "27.4.0",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
