{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "public/dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_ORIGIN"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**", "$TURBO_ROOT$/pnpm-lock.yaml"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false
    },
    "test:integration": {
      "cache": false
    },
    "@workout/api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@workout/server-persistence#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
