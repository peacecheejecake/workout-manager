{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "public/dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false
    },
    "test:integration": {
      "cache": false
    },
    "@workout/api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@workout/server-persistence#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
